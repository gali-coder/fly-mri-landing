# ── מדידה וקידום ממומן ─────────────────────────────────────────────────
# מוגדרים ב-Vercel: Project → Settings → Environment Variables (Production).
# מה שלא מוגדר — פשוט לא נטען, והאתר עובד כרגיל.

# Google Tag Manager container. פורמט: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook) Pixel ID — מספר בן ~15 ספרות.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Backend של הטופס (כבר מוגדר ב-Vercel) ─────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# אופציונלי — Google Sheets Apps Script Web App (/exec, הרשאה: Anyone)
SHEETS_WEBAPP_URL=
